# 8Career 環境変数テンプレート
# このファイルをコピーして .env.local を作り、実際の値を入れる（.env.local はコミットされない）
# Vercel では Project Settings > Environment Variables に同じ5つを登録する

# --- People Data Labs（到達者のキャリア統計データ）---
# https://dashboard.peopledatalabs.com/ の My API Key
PDL_API_KEY=

# --- Nebius Token Factory（NVIDIA Nemotron 推論）---
# Base URL は https://api.studio.nebius.com/v1 （OpenAI互換）
NEBIUS_API_KEY=

# --- Supabase ---
# Supabase ダッシュボード > Settings > API Keys から取得
# Project URL（例: https://abcdefgh.supabase.co）
NEXT_PUBLIC_SUPABASE_URL=
# 公開キー（sb_publishable_...）ブラウザに露出してよい。RLS で保護する
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 秘密キー（sb_secret_...）サーバー専用。RLS を無視できるため NEXT_PUBLIC_ を付けてはいけない
SUPABASE_SECRET_KEY=
